{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xbxrc",
  "version": "0.1.0",
  "identifier": "com.xuasir.xbxrc",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "xbxrc",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "resources": {
      "resources/ffmpeg/windows-x64/bin/*.dll": "",
      "resources/ffmpeg/windows-x64/bin/ffmpeg.exe": "resources/ffmpeg/windows-x64/bin/ffmpeg.exe",
      "resources/ffmpeg/windows-x64/bin/ffplay.exe": "resources/ffmpeg/windows-x64/bin/ffplay.exe",
      "resources/ffmpeg/windows-x64/bin/ffprobe.exe": "resources/ffmpeg/windows-x64/bin/ffprobe.exe",
      "resources/ffmpeg/macos-arm64/lib/*": "resources/ffmpeg/macos-arm64/lib/",
      "resources/ffmpeg/macos-x64/lib/*": "resources/ffmpeg/macos-x64/lib/",
      "resources/ffmpeg/LICENSE-NOTICE.md": "resources/ffmpeg/LICENSE-NOTICE.md",
      "resources/ffmpeg/COPYING.LGPLv2.1": "resources/ffmpeg/COPYING.LGPLv2.1"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
