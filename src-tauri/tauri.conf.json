{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xbxrc Native WIP",
  "version": "0.1.0",
  "identifier": "com.xuasir.xbxrc.native-wip",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": false,
    "windows": [
      {
        "title": "xbxrc Native WIP",
        "width": 800,
        "height": 600,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2MkNBNDE3NjA2NkMzOEMKUldTTXcyWmdGNlFzRmk3TDNKVXk5YitZMjNnOHRTeC9VSUZ1cDdFLzJrSzRXVmxYbnNBVU5KK00K",
      "endpoints": [
        "https://github.com/xuasir/xbxrc/releases/download/native-wip/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "26.0"
    },
    "resources": {},
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
