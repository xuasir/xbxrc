prefix=/tmp/ffmpeg-8.1/out-x64
exec_prefix=${prefix}
libdir=/tmp/ffmpeg-8.1/out-x64/lib
includedir=/tmp/ffmpeg-8.1/out-x64/include

Name: libavcodec
Description: FFmpeg codec library
Version: 62.28.100
Requires: 
