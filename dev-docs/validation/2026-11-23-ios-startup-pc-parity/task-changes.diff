+    let jwt_only =
+        json!({"gsToken": stream_token(now, 120, Some(now + 120_000))["data"]["gsToken"]});
+    assert!(is_stream_token_valid_at(&jwt_only, now));
+    for gs_token in [Value::Null, json!(""), json!(" ")] {
+        let mut token = stream_token(now, 120, None);
