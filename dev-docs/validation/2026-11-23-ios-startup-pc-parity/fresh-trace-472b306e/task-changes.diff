+fn auth_stage_retains_fixed_network_failure_details() {
+    let session = fixture_session();
+    let host = Observer::default();
+    let observer = BridgeAuthRenewal {
+        host: &host,
+        current: &session,
+        cache: None,
+        scope: DownstreamTokenScope::Cloud,
+    };
+    for (kind, name, retriable, failure_kind) in [
+        (
+            NetworkErrorKind::Dns,
+            "dns",
+            true,
+            crate::XboxQueryFailureKind::Network,
+        ),
+        (
+            NetworkErrorKind::Connect,
+            "connect",
+            true,
+            crate::XboxQueryFailureKind::Network,
+        ),
+        (
+            NetworkErrorKind::Tls,
+            "tls",
+            false,
+            crate::XboxQueryFailureKind::Network,
+        ),
+        (
+            NetworkErrorKind::Timeout,
+            "timeout",
+            true,
+            crate::XboxQueryFailureKind::Timeout,
+        ),
+        (
+            NetworkErrorKind::Body,
+            "body",
+            true,
+            crate::XboxQueryFailureKind::Network,
+        ),
+        (
+            NetworkErrorKind::Request,
+            "request",
+            false,
+            crate::XboxQueryFailureKind::Network,
+        ),
+    ] {
+        let mut facts = WebApiError::network_kind(kind).safe_summary();
+        facts["requestStage"] = json!("deviceToken");
+        facts["elapsedMs"] = json!(156);
+        observer.stage("authRequestFailed", facts);
+        let stages = host.stages.lock().unwrap();
+        let stage = stages.last().unwrap();
+        assert_eq!(stage.request_stage.as_deref(), Some("deviceToken"));
+        assert_eq!(stage.elapsed_ms, Some(156));
+        assert_eq!(stage.network_error_kind.as_deref(), Some(name));
+        assert_eq!(stage.failure.as_ref().unwrap().kind, failure_kind);
+        assert_eq!(stage.failure.as_ref().unwrap().retriable, retriable);
+    }
+}
