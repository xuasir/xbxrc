+private actor ParityGate {
+  private var ready = false
+  private var continuation: CheckedContinuation<Void, Never>?
+  func started() {
+    ready = true
+    continuation?.resume()
+    continuation = nil
+  }
+  func wait() async {
+    if ready { return }
+    await withCheckedContinuation { continuation = $0 }
+  }
+}
