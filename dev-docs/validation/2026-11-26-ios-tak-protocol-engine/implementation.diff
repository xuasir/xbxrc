+      let layout = try XCTUnwrap(TouchLayoutNormalizer.decode(Data(original.utf8)).first)
+      XCTAssertTrue(layout.report.isSupported, "\(layout.report.issues)")
+      let future = original.replacingOccurrences(of: "/v3.1/", with: "/v5.0/")
