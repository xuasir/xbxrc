+    let control = TouchControl(id: id, kind: kind, properties: item, compiled: compiled)
+    guard control.visible else { return }
+    result.append(
+      .init(
+        control: control, center: center,
+        diameter: max(20, diameter * CGFloat(control.scale)), unitSize: unit,
+        regionOrder: order))
+  }
