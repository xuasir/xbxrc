+  static func buttons(in socket: TouchControlSocket) -> [TouchControlSocket] {
+    let special =
+      socket.control.properties["specialPunch"]?.object != nil
+      || socket.control.properties["specialKick"]?.object != nil
+    let radius = socket.collisionRadius
+    let columns = special ? 4 : 3
+    let spacing = radius * (special ? 0.42 : 0.6)
+    let diameter = radius * (special ? 0.48 : 0.64)
+    var buttons: [TouchControlSocket] = []
+    for (row, suffix) in ["Punch", "Kick"].enumerated() {
+      for (column, prefix) in ["light", "medium", "heavy", "special"].enumerated() {
+        let name = prefix + suffix
+        guard var properties = socket.control.properties[name]?.object else { continue }
+        properties["type"] = .string("button")
+        let control = TouchControl(
+          id: socket.id + "/" + name, kind: .button, properties: .object(properties),
+          compiled: socket.control.compiled?.children[name])
+        guard control.visible else { continue }
+        let center = CGPoint(
+          x: socket.center.x + (CGFloat(column) - CGFloat(columns - 1) / 2) * spacing,
+          y: socket.center.y + (CGFloat(row) - 0.5) * radius * 0.8)
+        buttons.append(
+          .init(
+            control: control, center: center, diameter: diameter,
+            unitSize: diameter, regionOrder: socket.regionOrder))
+      }
+    }
+    return buttons
+  }
