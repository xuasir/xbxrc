+    func testIngressDrainContinuesWithinDeliveryAndYieldsAfterTwoFrames() {
+        let slot = StreamingLatestIngressSlot<Int>()
+        XCTAssertTrue(slot.submit(1))
+        var delivered: [Int] = []
+        let hasPending = slot.drain { delivery in
+            delivered.append(delivery.value)
+            XCTAssertFalse(slot.submit(delivery.value + 1))
+        }
+        XCTAssertEqual(delivered, [1, 2])
+        XCTAssertTrue(hasPending)
+        XCTAssertFalse(slot.drain { delivered.append($0.value) })
+        XCTAssertEqual(delivered, [1, 2, 3])
+        XCTAssertTrue(slot.submit(4))
+    }
